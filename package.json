{
  "name": "lizvault",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "esbuild src/renderer/index.tsx --bundle --outfile=dist/renderer/bundle.js --loader:.tsx=tsx --loader:.ts=ts",
    "build:css": "tailwindcss -i src/renderer/tailwind.css -o dist/renderer/index.css",
    "copy:html": "node -e \"require('fs').copyFileSync('src/renderer/index.html','dist/renderer/index.html')\"",
    "build": "npm run build:main && npm run build:renderer && npm run build:css && npm run copy:html",
    "dist": "npm run build && electron-builder",
    "watch:main": "tsc -p tsconfig.main.json -w",
    "watch:renderer": "esbuild src/renderer/index.tsx --bundle --outfile=dist/renderer/bundle.js --loader:.tsx=tsx --loader:.ts=ts --watch",
    "watch:css": "tailwindcss -i src/renderer/tailwind.css -o dist/renderer/index.css --watch",
    "dev": "npm run build && concurrently \"npm run watch:main\" \"npm run watch:renderer\" \"npm run watch:css\" \"electron .\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.lizvault.app",
    "productName": "LizVault",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/icons/LizVault_Logo.png"
    }
  },
  "dependencies": {
    "googleapis": "^174.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
