# Native modules must be built/fetched for Electron's runtime, not system Node.
# better-sqlite3 uses these to download its electron-v148 prebuilt binary
# (see package.json — pinned to the v12.12.0 GitHub tarball, the last version
# that ships prebuilds; v13.x is source-only and needs VS Build Tools).
runtime=electron
target=43.3.0
